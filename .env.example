# Server
PORT=8080
LOG_LEVEL=info

# Mode flags
DEMO_MODE=false
ENABLE_PR_FLOW=false

# Product repo (code-investigation target)
# Dev: absolute path to a local clone
# Prod: leave PRODUCT_REPO_PATH empty and set PRODUCT_REPO_URL; entrypoint clones at boot
PRODUCT_REPO_PATH=
PRODUCT_REPO_URL=

# Shortcut — if unset, uses mock client
SHORTCUT_API_TOKEN=
SHORTCUT_WORKSPACE=

# GitHub — if unset OR ENABLE_PR_FLOW=false, uses mock PR client
GITHUB_TOKEN=
GITHUB_REPO=
